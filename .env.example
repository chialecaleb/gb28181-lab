# Local preparation schema v1. Application loading is an M0 implementation task.
# Precedence: process environment > .env.local > .env. No interpolation.
LAB_PROFILE=local-test
LAB_HTTP_BIND=127.0.0.1:18081
LAB_DEVICE_SIP_BIND=127.0.0.1:15061
LAB_PLATFORM_SIP_BIND=127.0.0.1:15062
LAB_WEB_DEV_BIND=127.0.0.1:5173
LAB_SIP_TRANSPORT=UDP
LAB_DATA_DIR=.local/runtime
LAB_EVIDENCE_DIR=artifacts/m0
GB28181_STANDARDS_ROOT=
GB28181_REFERENCE_ROOT=reference

# Only testing tools may consume TEST_*; never expose these as VITE_*.
TEST_LIVEGBS_HTTP_URL=http://127.0.0.1:10000
TEST_LIVEGBS_USERNAME=
TEST_LIVEGBS_PASSWORD=
TEST_LIVEGBS_SIP_HOST=127.0.0.1
TEST_LIVEGBS_SIP_PORT=15060
# Synthetic example ID; replace locally with the authorized test platform ID.
TEST_LIVEGBS_SIP_ID=11010100002000000001
TEST_LIVEGBS_SIP_REALM=
TEST_LIVEGBS_SIP_AUTH_MODE=unknown
TEST_LIVEGBS_SIP_USERNAME=
TEST_LIVEGBS_SIP_PASSWORD=
TEST_LIVEGBS_SOURCE_ROOT=
TEST_LIVEGBS_API_DOC_URL=
